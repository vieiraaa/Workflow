{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git remote -v)", "Bash(git fetch:*)", "Bash(git describe:*)",
      "Bash(git rev-parse:*)", "Bash(git shortlog:*)", "Bash(ls:*)", "Bash(grep:*)"
    ],
    "ask": [
      "Bash(git push:*)", "Bash(git merge:*)", "Bash(git tag:*)", "Bash(git checkout:*)",
      "Bash(git switch:*)", "Bash(git remote add:*)", "Bash(git remote set-url:*)", "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Bash(cat .env*)", "Bash(type .env*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)", "Bash(git push origin --delete:*)", "Bash(git push origin \\:*)",
      "Bash(git reset --hard:*)", "Bash(git rebase:*)", "Bash(git clean:*)", "Bash(git filter-branch:*)",
      "Bash(git add -A:*)", "Bash(git add .:*)"
    ]
  }
}
